{
    "name": "@hankchen/canvas-image-renderer",
    "version": "0.1.0",
    "license": "MIT",
    "description": "graph → 透明底 PNG 的 Node 渲染后端：@napi-rs/canvas 五原语实现、EXIF 混合口径、资源物化默认接线（对位 go-canvas/image-renderer）",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HankChenCH/js-canvas.git",
        "directory": "packages/image-renderer"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "visualcheck": "node scripts/visualcheck.mjs"
    },
    "dependencies": {
        "@hankchen/canvas": "workspace:*",
        "@napi-rs/canvas": "1.0.13",
        "qrcode": "1.5.4"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "@types/qrcode": "^1.5.5",
        "tsup": "^8.5.0",
        "vitest": "^5.0.1"
    }
}
